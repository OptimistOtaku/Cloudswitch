# Agent credentials from Switch Console. Never commit a populated file.
SWITCH_URL=http://127.0.0.1:8000
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_ROOM_ID=
# Exact opaque participant IDs from room context, comma-separated for the team.
KITCHEN_OWNER_ID=
KITCHEN_TEAM_IDS=
KITCHEN_MODEL_BACKEND=codex
